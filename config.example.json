{
  "schemaVersion": 2,
  "paths": {
    "backup_root": "D:\\DSHBackups",
    "dsh_home": "C:\\Users\\YOURNAME\\.dsh",
    "checkout": "C:\\src\\deepseek-harness",
    "pnpm_store": "C:\\.pnpm-store\\v11",
    "workspace": "C:\\src\\WorkSpace"
  },
  "tools": {
    "seven_zip": "C:\\Program Files\\7-Zip\\7z.exe",
    "robocopy": "robocopy"
  },
  "ports": {
    "dsh": 3080,
    "mediainbox": 8080,
    "voicebox": 17493
  },
  "commands": {
    "start_cmd": "",
    "stop_cmd": "",
    "restart_cmd": "Start-ScheduledTask -TaskName 'DSH Restart Now'",
    "timeout_seconds": 300
  },
  "sets": {
    "baseline": {
      "roots": [
        {
          "label": "harness",
          "path": "{checkout}",
          "exclude_dirs": [
            "node_modules",
            ".git",
            ".vite",
            ".vite-temp",
            ".pnpm-task-run-state-v1"
          ]
        },
        {
          "label": "dsh",
          "path": "{dsh_home}",
          "exclude_dirs": [
            "sessions",
            "voicebox-cache"
          ]
        }
      ],
      "exclude_links": [
        "dsh\\profiles\\web\\node_modules\\dsh-peer",
        "dsh\\profiles\\web\\node_modules\\dsh-voicebox",
        "dsh\\profiles\\web\\node_modules\\@deepseek-ai\\dsh-subagent-codex"
      ]
    },
    "sessions": {
      "roots": [
        {
          "label": "sessions",
          "path": "{dsh_home}/sessions",
          "exclude_dirs": []
        }
      ],
      "exclude_links": []
    },
    "workspace": {
      "roots": [
        {
          "label": "WorkSpace",
          "path": "{workspace}",
          "exclude_dirs": [
            "out",
            "blender-out"
          ]
        }
      ],
      "exclude_links": []
    }
  },
  "kinds": {
    "store": {
      "enabled": true,
      "method": "mirror",
      "follow_baseline": true
    },
    "baseline": {
      "enabled": true,
      "method": "7z",
      "at": "03:30",
      "c": 720,
      "D": 1440,
      "M": 23040,
      "interval": 1440,
      "hold_delete_streak": 2
    },
    "sessions": {
      "enabled": true,
      "method": "7z",
      "every_minutes": 15,
      "c": 15,
      "D": 180,
      "M": 21600,
      "interval": 15,
      "hold_delete_streak": 2
    },
    "workspace": {
      "enabled": true,
      "method": "7z",
      "manual_only": true
    }
  },
  "compress": {
    "level": 5,
    "threads": "on",
    "extra_args": []
  },
  "retention": {
    "enabled": true,
    "hold_delete_streak": 2
  },
  "ui": {
    "window_width": 1080,
    "window_height": 760,
    "restore_dry_run_default": true
  }
}
